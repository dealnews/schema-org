{
    "name": "dealnews/schema-org",
    "description": "Schema.org value objects with JSON-LD emission",
    "type": "library",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.2",
        "moonspot/value-objects": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DealNews\\SchemaOrg\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DealNews\\SchemaOrg\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "php bin/generate.php",
        "test": "phpunit"
    }
}
